# ==============================================================================
# SINERGI VISUAL UGC STUDIO - ENVIRONMENT VARIABLES (.env.local)
# ==============================================================================

# 1. OpenAI API Key (Server-Side Backend Only)
# Wajib diisi di server agar model GPT-4o-mini & GPT-4o Vision dapat berjalan
OPENAI_API_KEY=sk-proj-...

# 2. Supabase Configuration (Auth & Database Profiles)
# Dapatkan dari Dashboard Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Supabase Service Role Key (Opsional / Recommended untuk server-side atomic credit deduction)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
